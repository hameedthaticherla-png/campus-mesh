# ============================================================
# Campus Mesh — Production Environment Configuration (.env.example)
# ============================================================
# Duplicate this file to .env and configure for your environment.
# NEVER commit .env containing actual secrets to version control!

# Server Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Security (REQUIRED in production: Cryptographically strong secret >= 32 characters)
JWT_SECRET=replace-with-secure-production-secret-min-32-chars

# Persistence & Storage
DATABASE_PATH=./storage/campus_mesh.db
STORAGE_DIR=./storage/uploads
SESSION_TTL_HOURS=3
MAX_RESOURCE_SIZE_MB=5120

# CORS Configuration (Configure with your production frontend domain, e.g. https://campus-mesh.vercel.app)
CORS_ORIGIN=*

# Frontend Environment Variables (apps/web)
# When deploying the frontend to Vercel, configure these in the Vercel project settings:
# VITE_API_URL=https://your-backend-domain.com
# VITE_WS_URL=wss://your-backend-domain.com/ws/signaling

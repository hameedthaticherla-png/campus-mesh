# Build Stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace configurations
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/

# Install all dependencies
RUN npm install

# Copy source files
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server

# Build packages
RUN npm run build --workspace=@campus-mesh/shared
RUN npm run build --workspace=@campus-mesh/server

# Production Runtime Stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
ENV DATABASE_PATH=/app/storage/campus_mesh.db
ENV STORAGE_DIR=/app/storage/uploads

# Ensure storage directories exist
RUN mkdir -p /app/storage/uploads/resources /app/storage/uploads/temporary

COPY package.json package-lock.json ./
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/server/package.json ./apps/server/
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY --from=builder /app/apps/server/src/database/schema.sql ./apps/server/dist/database/schema.sql
COPY --from=builder /app/apps/server/src/database/schema.sql ./apps/server/src/database/schema.sql

RUN npm install --omit=dev

EXPOSE 3001

CMD ["node", "apps/server/dist/index.js"]
